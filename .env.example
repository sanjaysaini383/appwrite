# --- Used by the browser app (safe to expose) ---
# Use your project's region in the endpoint, e.g. fra, nyc or sgp.
VITE_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=hearth
# Map falls back to this centre when the browser can't share location (Bengaluru)
VITE_DEFAULT_LAT=12.9716
VITE_DEFAULT_LNG=77.5946

# --- Used only by `npm run setup` / `seed` / `smoke` (never shipped to the browser) ---
# Needs the databases, tables, columns, indexes and rows scopes.
APPWRITE_API_KEY=your-server-api-key
